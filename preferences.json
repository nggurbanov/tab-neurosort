[
  {
    "type": "text",
    "label": "**NeuroSort** - AI-powered tab organization",
    "size": "14px",
    "margin": "0 0 10px 0"
  },
  {
    "type": "separator",
    "label": "Settings"
  },
  {
    "property": "extensions.neurosort.enabled",
    "type": "checkbox",
    "label": "Enable NeuroSort",
    "default": true
  },
  {
    "property": "extensions.neurosort.auto_tidy",
    "type": "checkbox",
    "label": "Auto-tidy tabs"
  },
  {
    "property": "extensions.neurosort.auto_tidy_threshold",
    "type": "number",
    "label": "Auto-tidy threshold",
    "default": 6
  },
  {
    "property": "extensions.neurosort.debug",
    "type": "checkbox",
    "label": "Debug mode"
  },
  {
    "type": "separator",
    "label": "AI Provider"
  },
  {
    "property": "extensions.neurosort.provider",
    "type": "dropdown",
    "label": "Provider",
    "default": "custom",
    "options": [
      { "value": "openai", "label": "OpenAI" },
      { "value": "gemini", "label": "Gemini" },
      { "value": "ollama", "label": "Ollama" },
      { "value": "custom", "label": "Custom" }
    ]
  },
  {
    "property": "extensions.neurosort.custom.endpoint",
    "type": "string",
    "label": "Endpoint URL",
    "default": "https://ai.redivo.ru/v1"
  },
  {
    "property": "extensions.neurosort.custom.api_key",
    "type": "string",
    "label": "API Key"
  },
  {
    "property": "extensions.neurosort.custom.model",
    "type": "string",
    "label": "Model",
    "default": "cx/gpt-5.1-codex-mini"
  }
]
